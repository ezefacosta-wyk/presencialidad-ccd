rules_version = '2';

// Reglas para el modo Firebase. La jerarquía se lee de /usuarios/{email}:
// cada documento tiene { rol, areaId, personaId, nombre } y la app lo
// mantiene sincronizado cuando se edita una persona.
//
//   jefe                    -> escribe todo
//   coordinador / adjunto   -> turnos de SU área (su rango o menor) y alta de
//                              personal de su área (solo rangos menores)
//   tecnico                 -> solo lectura
//
// Para arrancar: creá a mano en la consola el documento
//   /usuarios/<tu-email-en-minúsculas>  con  { rol: "jefe", nombre: "..." }

service cloud.firestore {
  match /databases/{database}/documents {

    function email() { return request.auth.token.email; }
    function logueado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(email()));
    }
    function yo() { return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function esJefe() { return logueado() && yo().rol == 'jefe'; }
    function coordina(areaId) {
      return logueado() && yo().rol in ['coordinador', 'adjunto'] && yo().areaId == areaId;
    }
    // Rangos que puede asignar un coordinador / adjunto dentro de su área
    function rolMenor(rol) {
      return rol == 'tecnico' || (rol == 'adjunto' && yo().rol == 'coordinador');
    }
    function gestionaPersona(d) { return coordina(d.areaId) && rolMenor(d.rol); }
    function rango(r) { return r == 'jefe' ? 4 : (r == 'coordinador' ? 3 : (r == 'adjunto' ? 2 : 1)); }
    // Turnos: de su área y de alguien con su mismo rango o menor
    function cargaTurnos(d) {
      return esJefe() || (coordina(d.areaId)
        && rango(get(/databases/$(database)/documents/personas/$(d.personaId)).data.rol) <= rango(yo().rol));
    }

    match /usuarios/{userEmail} {
      allow read: if request.auth != null && (email() == userEmail || logueado());
      allow create: if esJefe() || gestionaPersona(request.resource.data);
      allow update: if esJefe() || (gestionaPersona(resource.data) && gestionaPersona(request.resource.data));
      allow delete: if esJefe() || gestionaPersona(resource.data);
    }
    match /personas/{personaId} {
      allow read: if logueado();
      allow create: if esJefe() || gestionaPersona(request.resource.data);
      allow update: if esJefe() || (gestionaPersona(resource.data) && gestionaPersona(request.resource.data));
      allow delete: if esJefe() || gestionaPersona(resource.data);
    }
    match /turnos/{turnoId} {
      allow read: if logueado();
      allow create: if cargaTurnos(request.resource.data);
      allow update: if cargaTurnos(resource.data) && cargaTurnos(request.resource.data);
      allow delete: if cargaTurnos(resource.data);
    }
    match /areas/{id}      { allow read: if logueado(); allow write: if esJefe(); }
    match /tiposTurno/{id} { allow read: if logueado(); allow write: if esJefe(); }
    match /feriados/{id}   { allow read: if logueado(); allow write: if esJefe(); }
    match /config/{id}     { allow read: if logueado(); allow write: if esJefe(); }
  }
}
